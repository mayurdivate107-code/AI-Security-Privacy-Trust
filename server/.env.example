# AegisAI Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aegisai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=aegis_ai_super_secret_jwt_encryption_key_2026_production

# Google Gemini API Key (Required for AI Firewall & Threat Inspection)
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173
